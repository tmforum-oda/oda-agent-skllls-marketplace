@startuml
title CSP's Offer modelization (In progress, December 2025)

legend left
  |= Color |= Meaning |
  | <back:white>Blue outline</back> | Product Offering characteristics |
  | <back:#d5e8d4>Green outline</back> | Product Specification characteristics |
  | <back:orange>Orange fill</back> | CFS |
  | <back:white>Orange outline</back> | RFS |
endlegend

class "CSP's Offer\n(SASE Solution)" as SASE <<Product Offering>>

class "SSE Solution" as SSESolution <<Product Offering>>
class "Overlay Offer\n(SDWAN Solution)" as OverlaySolution <<Product Offering>>
class "Underlay Offer" as UnderlayOffer <<Product Offering>>

SASE *-- SSESolution
SASE *-- OverlaySolution
SASE *-- UnderlayOffer

class "SSE Offer" as SSEOffer <<Product Offering>>
class "SSE Product" as SSEProduct <<Product Specification>>

class "Overlay" as Overlay <<Product Offering>>
class "Self Management" as SelfManagement <<Product Offering>>
class "Site" as Site <<Product Offering>>

OverlaySolution "1..n" *-- Overlay
OverlaySolution "0..1" *-- SelfManagement
OverlaySolution "1..n" *-- Site

class "SDWAN Network" as SDWANNetwork <<Product Specification>> {
  xxx
}
class "ZTP Product\n(console)" as ZTPProduct <<Product Specification>> {
  xxx
}
class "SDWAN Edge" as SDWANEdge <<Product Specification>> {
  xxx
}

SSEProduct --> SDWANNetwork : requires

class "Underlay connectivity" as UnderlayConnOffer <<Product Offering>>
class "Access" as AccessOffer <<Product Offering>>

UnderlayOffer "0..1" *-- UnderlayConnOffer
UnderlayOffer "0..1" *-- AccessOffer

class "Underlay Connectivity" as UnderlayConnSpec <<Product Specification>> {
  xxx
}
class "Access" as AccessSpec <<Product Specification>> {
  location
}

SDWANEdge --> UnderlayConnSpec : requires

class "CFS" as CFS_SDWAN <<CFS>>
class "CFS" as CFS_ZTP <<CFS>>

SDWANNetwork --> CFS_SDWAN
ZTPProduct --> CFS_ZTP

class "RFS 1" as RFS1 <<RFS>>
class "RFS2" as RFS2 <<RFS>>
class "..." as RFSMoreLeft <<RFS>>
class "SDW V1" as SDWV1 <<RFS>>
class "VM" as VM_RFS <<RFS>>
class "SDW V2" as SDWV2 <<RFS>>
class "..." as RFSMoreRight <<RFS>>

CFS_SDWAN --> RFS1 : OR
CFS_SDWAN --> RFS2 : OR
RFS1 --> RFSMoreLeft
RFS1 --> SDWV1
RFS1 --> VM_RFS
RFS2 --> SDWV1
RFS2 --> VM_RFS
RFS2 --> SDWV2
RFS2 --> RFSMoreRight

class "VM PA" as VMPA <<RFS>>
class "VM PB" as VMPB <<RFS>>

SDWV1 --> VMPA : OR
SDWV1 --> VMPB : OR

class "by CSP" as ByCSP <<RFS>>
class "by Vendor" as ByVendor <<RFS>>

CFS_ZTP --> ByCSP : OR
CFS_ZTP --> ByVendor : OR

class "EMS V1" as EMSV1 <<RFS>>
class "EMS V2" as EMSV2 <<RFS>>

ByVendor --> EMSV1 : OR
ByVendor --> EMSV2 : OR

circle "V1" as V1Ref

EMSV1 ..> V1Ref

package "Partner Catalogue" {
  class "SSE Provider" as SSEProviderGroup {
    P1
  }
  class "SDWAN Vendors" as SDWANVendorsGroup {
    V2
    V1
  }
  class "Cloud Providers" as CloudProvidersGroup {
    PB
    PA
  }
}

' Dashed cross-reference lines in the source diagram route unlabeled
' correspondences from catalog leaf nodes to the matching Partner
' Catalogue entry (matched here by shared V1/V2/PA/PB/P1 labels).
SSEProduct ..> SSEProviderGroup
V1Ref ..> SDWANVendorsGroup
SDWV2 ..> SDWANVendorsGroup
VMPA ..> CloudProvidersGroup
VMPB ..> CloudProvidersGroup

@enduml
