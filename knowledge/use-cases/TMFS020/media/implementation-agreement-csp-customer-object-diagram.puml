}
object "Greenfield IB / MEF Systems Agreement Term or Condition:\nAgreementTermOrCondition" as AgreementTermOrCondition
object "Greenfield IB / MEF Systems SASE Offer Framework Agreement Item:\nFrameworkAgreementItem" as FrameworkAgreementItem {
