object "MEF Systems SASE Offer Opportunity Item:\nSalesOpportunityItem" as SalesOpportunityItem

object "Greenfield IB Sales Implementation Agreement Spec:\nImplementationAgreementSpecification" as ImplementationAgreementSpec

