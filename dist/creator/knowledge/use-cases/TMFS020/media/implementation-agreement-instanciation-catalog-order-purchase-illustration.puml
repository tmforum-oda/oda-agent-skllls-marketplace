@startuml
title Implementation Agreement instanciation - Catalog / Inventory / Order / Purchase / Agreement ("Simplified illustrations")

legend left
  |= Mark |= Meaning |
  | red dashed arrow | corresponds to |
  | "/" | Heritage (inherited from the Framework Agreement illustration) |
endlegend

class "Customer\nXX" as CustomerXX
note left of CustomerXX
  10 sites
  300 sites, 5 Years
end note

package "CSP" {

  package "Product Catalog (TMFC001)" as CSPCatalog {
    class "SASE Solution by CSP" as SASESolution <<Heritage>>
    class "Underlay" as Underlay <<Heritage>>
    class "Cloud" as Cloud <<Heritage>>
    class "SDWAN" as SDWAN <<Heritage>>
    class "SSE" as SSECatalog

    SASESolution *-- Underlay
    SASESolution *-- Cloud
    SASESolution *-- SDWAN
    SASESolution *-- SSECatalog

    package "Supplier Catalog View" as SupplierCatalogView {
      class "SSE by P1" as SSEbyP1
      class "SDWAN by Vx" as SDWANbyVx <<Heritage>>
      class "Cloud by Py" as CloudbyPy <<Heritage>>
    }

    SSECatalog --> SSEbyP1
    SDWAN --> SDWANbyVx
    Cloud --> CloudbyPy
  }

  package "Product Inventory (TMFC005)" as CSPInventory {
    class "SASE Solution for Cust" as SASEInventory
    class "SSE" as SSEInventory

    SASEInventory *-- SSEInventory

    package "Supplier Inventory View" as SupplierInventoryView {
      class "SSE by P1 for cust XX" as SSEbyP1ForCust
      note right of SSEbyP1ForCust : (?) open question in source
    }

    SSEInventory --> SSEbyP1ForCust
  }

  SASESolution ..> SASEInventory : instantiates
  SSECatalog ..> SSEInventory : instantiates

  package "Order (TMFC002)" as CSPOrder {
    class "Customer Product Order" as CustomerProductOrder
    class "CPOOI 1 «SDWAN»" as CPOOI1
    class "CPOOI 1.1 «SSE»" as CPOOI11
    class "CPOOI 1.2 ..." as CPOOI12
    class "CPOOI 1.3 ..." as CPOOI13

    CustomerProductOrder *-- CPOOI1
    CPOOI1 *-- CPOOI11
    CPOOI1 *-- CPOOI12
    CPOOI1 *-- CPOOI13
  }

  SSEInventory --> CustomerProductOrder
  CPOOI11 ..> SSEbyP1ForCust

  package "Purchase (TMFC033)" as CSPPurchase {
    class "Purchase Order\n(BusinessPartnerProductOrder)" as PurchaseOrder
    note right of PurchaseOrder : (?) open question in source
    class "PurchaseOrderItem" as PurchaseOrderItem

    PurchaseOrder *-- PurchaseOrderItem
  }

  CPOOI11 ..> PurchaseOrder
  PurchaseOrder ..> SSEbyP1ForCust

  package "Agreement (TMFC039)" as CSPAgreement {
    class "Framework Agreement for XX" as FAforXX
    class "ImplemAgreementSpec for Cust." as ImplSpecCust
    class "Framework Agreement Spec for cust" as FASpecCust
    class "Implementation Agreement" as CSPImplAgreementCust
    class "Impl Ag. Item 1" as ImplAgItem1
    class "Impl Ag. Item 1.1" as ImplAgItem11

    FASpecCust --> ImplSpecCust
    ImplSpecCust --> FAforXX
    FAforXX ..> CSPImplAgreementCust : instantiates
    CSPImplAgreementCust *-- ImplAgItem1
    ImplAgItem1 *-- ImplAgItem11

    class "Framework Agreement" as CSPFrameworkAgreement
    class "ImplemAgreementSpec for Supplier" as ImplSpecSupplier
    class "Framework Agreement Spec for Supplier" as FASpecSupplier
    class "Implementation Agreement" as CSPImplAgreementSupplier
    class "Agreement Item 1" as AgreementItem1

    FASpecSupplier --> ImplSpecSupplier
    ImplSpecSupplier --> CSPFrameworkAgreement
    CSPFrameworkAgreement ..> CSPImplAgreementSupplier : instantiates
    CSPImplAgreementSupplier *-- AgreementItem1

    ImplSpecSupplier ..> ImplSpecCust : T&C
  }

  CustomerXX --> FAforXX
  ImplAgItem11 ..> CustomerProductOrder
  AgreementItem1 ..> PurchaseOrderItem
}

note bottom of CSPAgreement : Opportunity and Quote will be described in a future version of the UC

package "SSE Provider P1" as SSEProviderP1 <<Simplified illustrations>> {
  package "Product Catalog (TMFC001)" as SupplierCatalog {
    class "SSE" as SupplierSSE
  }
  package "Product Inventory (TMFC005)" as SupplierInventory {
    class "SSE for CSP's cust XX" as SupplierSSEInventory
  }
  package "Order (TMFC002)" as SupplierOrder {
    class "Customer Product Order" as SupplierCustomerProductOrder
    class "CPOOI 1 SSE" as SupplierCPOOI1
    SupplierCustomerProductOrder *-- SupplierCPOOI1
  }
  package "Agreement (TMFC039)" as SupplierAgreement {
    class "Framework Agreement" as SupplierFrameworkAgreement
    class "Implementation Agreement" as SupplierImplAgreement
    class "Agreement Item 1" as SupplierAgreementItem1
    SupplierFrameworkAgreement ..> SupplierImplAgreement : instantiates
    SupplierImplAgreement *-- SupplierAgreementItem1
  }

  SupplierSSE ..> SupplierSSEInventory : instantiates
  SupplierSSEInventory --> SupplierCustomerProductOrder
}

SSEbyP1 <..> SupplierSSE : corresponds to
SSEbyP1ForCust <..> SupplierSSEInventory : corresponds to
CSPFrameworkAgreement <..> SupplierFrameworkAgreement : corresponds to
SupplierSSE ..> CSPFrameworkAgreement : involves
PurchaseOrder ..> SupplierCPOOI1
PurchaseOrderItem ..> SupplierAgreementItem1

note "CPOOI CustomerProductOfferingOrderItem" as CPOOILegend

@enduml
