@startuml
title object Figure A.14 - Illustration 03: FrameworkAgreement between CSP and Customer

object "Greenfield International Business:\nOrganization" as GreenfieldOrg {
  isLegalEntity = true
}
object "Middle East Finance Systems:\nOrganization" as MEFOrg {
  isLegalEntity = true
}

object "Greenfield IB:\nAgreementRole" as GreenfieldRole
object "MEF Systems:\nAgreementRole" as MEFRole

object "MEF Systems Sales\nLead: SalesLead" as SalesLead

object "MEF Systems B2B Offers Sales Opportunity /\nsalesOpportunity: SalesOpportunity" as SalesOpportunity {
  type = New business
}

object "MEF Systems SASE Offer Opportunity Item:\nSalesOpportunityItem" as SalesOpportunityItem

object "Greenfield IB Sale Framework Agreement Spec:\nFrameworkAgreementSpecification" as FrameworkAgreementSpec

object "Greenfield IB / MEF Systems Framework Agreement:\nFrameworkAgreement" as FrameworkAgreement {
  validFor = From 2025/10/01 to 2027/09/30
}

object "Greenfield IB / MEF Systems Agreement Term or Condition:\nAgreementTermOrCondition" as AgreementTermOrCondition

object "Greenfield IB / MEF Systems SASE Offer Framework Agreement Item:\nFrameworkAgreementItem" as FAItemSASE {
  validFor = From 2025/10/01 to 2025/08/31
}
object "GreenField IB / MEF Systems Ethic clauses:\nFrameworkAgreementItem" as FAItemEthic {
  validFor = From 2025/10/01 to 2027/09/30
}
object "GreenField IB / MEF Systems Payment Conditions:\nFrameworkAgreementItem" as FAItemPayment {
  validFor = From 2025/10/01 to 2027/09/30
}

object "MEF Systems Prices Alteration for SASE:\nProdOfferPriceAlteration" as ProdOfferPriceAlteration
object "Greenfield IB SASE Offer Price Plan:\nProductOfferingPrice" as ProductOfferingPrice
object "Greenfield IB SASE Offer:\nCompositeProductOfferingSpecification" as CompositePOSpec
object "Greenfield IB Offer standard Term or Condition:\nProductOfferingTermOrCondition" as ProductOfferingTermOrCondition

object "Greenfield IB / MEF Systems Framework Agreement Document:\nDocument" as Document

object "Greenfiled IB / MEF Systems Framework Agreement Validity Area:\nAgreementLocationRole" as AgreementLocationRoleForAgreement {
  type = Validity area
}
object "Greenfield IB SASE Offer FrameworkAgreementItem valid locations:\nAgreementLocationRole" as AgreementLocationRoleForItem {
  type = Validity area
}
object "Middle East Countries:\nPlace" as MiddleEastPlace

object "Create, Update, Cancel:\nAllowedProductAction" as AllowedProductAction

GreenfieldOrg --> GreenfieldRole : :/OrganisationPlays
MEFOrg --> MEFRole : :/OrganisationPlays

SalesLead --> SalesOpportunity : :SalesLeadLeadsToSalesOpportunity
GreenfieldRole --> SalesOpportunity : :PartyRoleInvolvedInSalesOpportunity
MEFRole --> SalesOpportunity : :PartyRoleInvolvedInSalesOpportunity
SalesOpportunity --> SalesOpportunityItem : :SalesOpportunityContains

GreenfieldRole --> FrameworkAgreement : :AgreementInvolves
MEFRole --> FrameworkAgreement : :AgreementInvolves
FrameworkAgreement --> FrameworkAgreementSpec : :FrameworkAgreementDescribedBy
SalesOpportunity --> FrameworkAgreement : :SalesOpportunityCanResultIn
FrameworkAgreement --> AgreementTermOrCondition : :/FrameworkAgreementGovernedBy
FrameworkAgreement --> Document : :DocumentFormalizesAgreement
FrameworkAgreement --> AgreementLocationRoleForAgreement : :AgreementLocationSpecifiesThePlaceForAgreement

FrameworkAgreement --> FAItemSASE : :/FrameworkAgreementConsistsOf
FrameworkAgreement --> FAItemEthic : :/FrameworkAgreementConsistsOf
FrameworkAgreement --> FAItemPayment : :/FrameworkAgreementConsistsOf

SalesOpportunityItem --> FAItemSASE : :SalesOpportunityItemCanResultIn
FAItemSASE --> AgreementTermOrCondition : :/FrameworkAgreementItemGovernedBy
FAItemSASE --> ProdOfferPriceAlteration : :FrameworkAgreementItemHoldsNegotiated
FAItemSASE --> CompositePOSpec : :FrameworkAgreementItemConcerns
FAItemSASE --> AgreementLocationRoleForItem : :AgreementLocationSpecifiesThePlaceForAgreementItem
FAItemSASE --> AllowedProductAction : :FrameworkAgreementItemRestrictsPossibleAllowedProductAction

ProductOfferingPrice --> ProdOfferPriceAlteration : :ProdOfferPriceImpactedBy
CompositePOSpec --> ProductOfferingPrice : :ProductOfferingSpecificationValuedBy
CompositePOSpec --> ProductOfferingTermOrCondition : :ProdOfferAgreementRequirementsRepresentedAs
ProductOfferingTermOrCondition --> AgreementTermOrCondition : :ProductTermAppearsAs

AgreementLocationRoleForAgreement --> MiddleEastPlace : :AgreementLocationRoleSpecifiesPlace
AgreementLocationRoleForItem --> MiddleEastPlace : :AgreementLocationRoleSpecifiesPlace

@enduml
