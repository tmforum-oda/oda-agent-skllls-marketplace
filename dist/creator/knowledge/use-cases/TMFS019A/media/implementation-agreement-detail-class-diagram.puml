@startuml
title Figure A.15a - Implementation Agreement details

class AgreementTermOrCondition <<Entity>> {
  + validFor : TimePeriod
  «required»
  + description : String
  + number : String
}

class "ImplementationAgreement" as ImplementationAgreement <<ContractualAgreement>>
class "ImplementationAgreementItem" as ImplementationAgreementItem <<ContractualAgreementItem>>

AgreementTermOrCondition "0..*" <-- "1" ImplementationAgreement : /ImplementationAgreementGovernedBy
AgreementTermOrCondition "0..*" <-- "0..*" ImplementationAgreementItem : /ImplementationAgreementItemGovernedBy
ImplementationAgreement "1" o-- "0..*" ImplementationAgreementItem : /ImplementationAgreementConsistsOf

class "ProductOrder" as ProductOrder <<RootEntity>> {
  + assignedPriority : Integer
  + assignedResponsibilityDate : DateTime
  + dueDate : DateTime
  + expectedCompletionDate : DateTime
  + purchaseOrderNumber : String
  + requestedCompletionDate : DateTime
  + requestedStartDate : DateTime
  + status : String
  + type : String
  + validFor : TimePeriod
}
ImplementationAgreement "0..1" <-- "0..*" ProductOrder : ImplementationAgreementRefersTo

class "ProductOfferingOrderItem" as ProductOfferingOrderItem {
  + status : String
}
ImplementationAgreementItem "0..1" <-- "0..*" ProductOfferingOrderItem : ImplementationAgreementItemRefersTo
ProductOrder "1" o-- "0..*" ProductOfferingOrderItem : /ProductOrderComprisedOf

class "ProductOfferingInstance" as ProductOfferingInstance <<Entity>> {
  + status : String
  + validFor : TimePeriod
}
ProductOfferingOrderItem "0..*" --> "*" ProductOfferingInstance : ProductOfferingOrderItemInvolvesPOI

class "ProdOfferPriceAlteration" as ProdOfferPriceAlteration <<ComponentProdOfferPrice>> {
  + applicationDuration : Duration
  + percentage
}
ImplementationAgreementItem "1" --> "0..*" ProdOfferPriceAlteration : ImplementationAgreementItemCanHoldNegotiated

class "ProductOfferingSpecification" as ProductOfferingSpecification <<EntitySpecification>> {
  + isPromotion : Boolean
  + isSellableStandAlone : Boolean
}
ImplementationAgreementItem "1" --> "0..1" ProductOfferingSpecification : ImplemtationAgreementItemCanInvolve
ImplementationAgreementItem "0..*" --> "0..*" ProductOfferingInstance : ImplementationAgreementItemCanInvolve

class "ProductOfferingTermOrCondition" as ProductOfferingTermOrCondition
ProductOfferingSpecification "0..*" <--> "0..*" ProductOfferingTermOrCondition : ProdOfferAgreementRequirementsRepresentedAs
ProductOfferingTermOrCondition "0..*" --> "0..*" AgreementTermOrCondition : ProductTermAppearsAs

class "ProductOfferingPrice" {
  «required»
  + ID : String
  + name : String
  + description : String
  + validFor : TimePeriod
}
class "ProductPrice" {
  «required»
  + name : String
  + description : String
  + validFor : TimePeriod
}
ProdOfferPriceAlteration "0..*" --> "1..*" ProductOfferingPrice : ProdOfferPriceImpactedBy
ProductOfferingSpecification "0..*" --> "0..*" ProductOfferingPrice : ProductOfferingSpecificationValuedBy
ProductOfferingSpecification "1" <--> "0..*" ProductOfferingInstance : /ProductOfferingSpecificationDescribes
ProductOfferingInstance "0..1" o-- "0..*" ProductPrice : ProductOfferingInstanceValuedByPrice
ProductOfferingPrice "1" <--> "0..*" ProductPrice : ProductPriceRealizesOrSubstitutes
ProductOfferingTermOrCondition "0..*" --> "0..*" ProductOfferingPrice : ProductOfferingTermInfluences
@enduml
