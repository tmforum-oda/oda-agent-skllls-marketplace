@startuml
allowmixing
title TMFC035 : Party Roles & Permissions Management -- Dependent APIs (API / Resource / Operation)

object dependentAPIs

object TMF632 {
  id = TMF632
  name = Party Management API
  required = true
  resources = (see below)
  version = 4
}

object TMF701 {
  id = TMF701
  name = Process Flow Management API
  required = false
  resources = (see below)
  version = 4
}

dependentAPIs --> TMF632
dependentAPIs --> TMF701

object individual
object organization
object processFlow
object taskFlow

TMF632 --> individual
TMF632 --> organization
TMF701 --> processFlow
TMF701 --> taskFlow

rectangle "GET\nGET/id" as individualOps
rectangle "GET\nGET/id" as organizationOps
rectangle "POST\nGET\nGET /id\nDELETE" as processFlowOps
rectangle "PATCH\nGET\nGET /id" as taskFlowOps

individual --> individualOps
organization --> organizationOps
processFlow --> processFlowOps
taskFlow --> taskFlowOps
@enduml
