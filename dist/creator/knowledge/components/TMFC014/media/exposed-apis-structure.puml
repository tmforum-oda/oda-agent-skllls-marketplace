@startuml
allowmixing
title TMFC014 : Location Management -- Exposed APIs (API / Resource / Operation)

object exposedAPIs

object TMF673 {
  id = TMF673
  name = Geographic Address Management API
  required = true
  resources = (see below)
  version = 4
}

object TMF674 {
  id = TMF674
  name = Geographic Site Management API
  required = true
  resources = (see below)
  version = 4
}

object TMF675 {
  id = TMF675
  name = Geographic Location Management API
  required = true
  resources = (see below)
  version = 4
}

object TMF701 {
  id = TMF701
  name = Process Flow Management API
  required = false
  resources = (see below)
  version = 4
}

exposedAPIs --> TMF673
exposedAPIs --> TMF674
exposedAPIs --> TMF675
exposedAPIs --> TMF701

object geographicAddressValidation
object geographicAddress
object geographicSubAddress
object geographicSite
object geographicLocation
object processFlow
object taskFlow

TMF673 --> geographicAddressValidation
TMF673 --> geographicAddress
TMF673 --> geographicSubAddress
TMF674 --> geographicSite
TMF675 --> geographicLocation
TMF701 --> processFlow
TMF701 --> taskFlow

rectangle "GET\nGET /id\nPOST\nPATCH" as geographicAddressValidationOps
rectangle "GET\nGET /id" as geographicAddressOps
rectangle "GET\nGET /id" as geographicSubAddressOps
rectangle "GET\nGET /id\nPOST\nPATCH\nDELETE" as geographicSiteOps
rectangle "GET\nGET /id\nPOST\nPATCH\nDELETE" as geographicLocationOps
rectangle "POST\nGET\nGET /id\nDELETE" as processFlowOps
rectangle "PATCH\nGET\nGET /id" as taskFlowOps

geographicAddressValidation --> geographicAddressValidationOps
geographicAddress --> geographicAddressOps
geographicSubAddress --> geographicSubAddressOps
geographicSite --> geographicSiteOps
geographicLocation --> geographicLocationOps
processFlow --> processFlowOps
taskFlow --> taskFlowOps
