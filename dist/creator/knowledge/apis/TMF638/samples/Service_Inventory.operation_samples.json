                },
                {
                    "description": "Here's an example of a request for retrieving multiple services from inventory with field selection.",
                    "fields": "id,name,state", 
                    "filtering": "state=active", 
                    "content-type": "application/json", 
                    "response" : "$_Service_list_1_response_withFieldSelection"
                }
            ]
        }, 
        "retrieve": {
            "samples" : [
                {
                    "description" : "Here's an example of a request for retrieving a specific service from inventory.",
