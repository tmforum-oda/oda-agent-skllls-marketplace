@startuml
allowmixing
title TMFC014 : Location Management -- Events (API / Resource / Event)

object publishedEvents
object subscribedEvents

object TMF673 {
  id = TMF673
  name = Geographic Address Management API
  resources = (see below)
}

object TMF674pub {
  id = TMF674
  name = Geographic Site Management API
  resources = (see below)
}

object TMF675 {
  id = TMF675
  name = Geographic Location API
  resources = (see below)
}

object TMF632 {
  id = TMF632
  name = Party Management API
  resources = (see below)
}

object TMF620 {
  id = TMF620
  name = Geographic Site Management API
  resources = (see below)
}

publishedEvents --> TMF673
publishedEvents --> TMF674pub
publishedEvents --> TMF675

subscribedEvents --> TMF632
subscribedEvents --> TMF620

rectangle "geographicAddressValidationCreateEvent\ngeographicAddressValidationAttributeValueChangeEvent\ngeographicAddressValidationDeleteEvent\ngeographicAddressStatusChangeEvent" as TMF673Events
rectangle "geographicSiteCreateEvent\ngeographicSiteAttributeValueChangeEvent\ngeographicSiteDeleteEvent\ngeographicSiteStatusChangeEvent" as TMF674pubEvents
rectangle "geographicLocationCreateEvent\ngeographicLocationAttributeValueChangeEvent\ngeographicLocationDeleteEvent\ngeographicLocationStatusChangeEvent" as TMF675Events
rectangle "IndividualDeleteEvent\nOrganizationDeleteEvent" as TMF632Events
rectangle "geographicSite" as TMF620Events

TMF673 --> TMF673Events
TMF674pub --> TMF674pubEvents
TMF675 --> TMF675Events
TMF632 --> TMF632Events
TMF620 --> TMF620Events

note right of TMF620
  Printed in the source image as "TMF620" with name
  "Geographic Site Management API" -- reproduced as-is,
  even though TMF620 is Product Catalog Management
  elsewhere in the TM Forum API suite and TMF674 is the
  actual Geographic Site Management API id used elsewhere
  in this same component spec. Not corrected here since
  this redraw is of exactly what the image shows.
end note
@enduml
