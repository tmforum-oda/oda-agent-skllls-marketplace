@startuml
allowmixing
title TMFC012 : Resource Inventory -- Exposed APIs (API / Resource / Operation)

object exposedAPIs

object TMF639 {
  id = TMF639
  name = Resource Inventory API
  required = true
  resources = (see below)
  version = 4
}

object TMF701 {
  id = TMF701
  name = Process Flow Management API
  required = false
  resources = (see below)
  version = 4
}

exposedAPIs --> TMF639
exposedAPIs --> TMF701

object resource
object processFlow
object taskFlow

TMF639 --> resource
TMF701 --> processFlow
TMF701 --> taskFlow

rectangle "GET\nGET /id\nPOST\nPATCH\nDELETE" as resourceOps
rectangle "POST\nGET\nGET /id\nDELETE" as processFlowOps
rectangle "PATCH\nGET\nGET /id" as taskFlowOps

resource --> resourceOps
processFlow --> processFlowOps
taskFlow --> taskFlowOps
@enduml
