@startuml
allowmixing

object publishedSubscribedEvents {
  publishedEvents
  subscribedEvents
}

object "TMF634" as API1 {
  id = TMF634
  name = Resource Catalog Management API
}
rectangle "resourceCatalogCreateEvent\nresourceCatalogChangeEvent\nresourceCatalogDeleteEvent\nresourceCategoryCreateEvent\nresourceCategoryChangeEvent\nresourceCategoryDeleteEvent\nresourceCandidateCreateEvent\nresourceCandidateChangeEvent\nresourceCandidateDeleteEvent\nresourceSpecificationCreateEvent\nresourceSpecificationChangeEvent\nresourceSpecificationDeleteEvent\nimportJobCreateEvent\nexportJobCreateEvent\nexportJobStateChangeEvent" as EV1

object "TMF701" as API2 {
  id = TMF701
  name = Process Flow Management API
}
rectangle "processFlowCreateEvent\nprocessFlowStateChangeEvent\nprocessFlowStateDeleteEvent\nprocessFlowStateAttributeValueChangeEvent\ntaskFlowCreateEvent\ntaskFlowStateChangeEvent\ntaskFlowDeleteEvent\ntaskFlowAttributeValueChangeEvent\ntaskFlowInformationRequiredEvent" as EV2

' The source image's third box (subscribed side) prints id "TMF632" paired
' with name "Entity Catalog Management API" -- TMF632 is Party Management
' everywhere else in this document (including the very next box below, which
' correctly pairs TMF632 with "Party Management API"). Reproduced verbatim
' as a source mismatch, not corrected -- same "redraw exactly what's shown"
' treatment given to every other id/name inconsistency found across this
' batch of components.
object "TMF632 (Entity Catalog)" as API3 {
  id = TMF632
  name = Entity Catalog Management API
}
rectangle "entitySpecificationCreateEvent\nentitySpecificationAttributeValueChangeEvent\nentitySpecificationStateChangeEvent\nentitySpecificationDeleteEvent" as EV3

object "TMF669" as API4 {
  id = TMF669
  name = Party Role Management
}
rectangle "partyRoleDeleteEvent" as EV4

object "TMF632" as API5 {
  id = TMF632
  name = Party Management API
}
rectangle "individualDeleteEvent\norganizationDeleteEvent" as EV5

publishedSubscribedEvents::publishedEvents --> API1
publishedSubscribedEvents::publishedEvents --> API2

publishedSubscribedEvents::subscribedEvents --> API3
publishedSubscribedEvents::subscribedEvents --> API4
publishedSubscribedEvents::subscribedEvents --> API5

API1 --> EV1
API2 --> EV2
API3 --> EV3
API4 --> EV4
API5 --> EV5

@enduml
